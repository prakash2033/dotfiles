font-family = Adwaita Sans Medium
font-style = Medium
font-thicken = false
font-size = 12

adjust-underline-position = 40%
adjust-underline-thickness = -60%

cursor-style = block
cursor-style-blink = true

shell-integration = zsh
shell-integration-features = no-cursor

confirm-close-surface = false
clipboard-paste-protection = false
unfocused-split-opacity = 1.0

theme = Gruvbox Dark Hard

copy-on-select = clipboard
scrollback-limit = 134217728

maximize = true
# fullscreen = true
# window-decoration = false
# gtk-titlebar = false

keybind = ctrl+shift+r=reload_config
keybind = ctrl+b=toggle_window_decorations
keybind = ctrl+f=toggle_fullscreen

quick-terminal-position="top"
quick-terminal-autohide="false"
keybind =global:§=toggle_quick_terminal
