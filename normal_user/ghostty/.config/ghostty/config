# Font Configuration
font-size = 12

# Window Configuration
window-decoration = true
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Key bindings for common actions
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = true

# Bell Configuration
bell-features = "no-title, no-attention, no-border, no-audio, no-system"

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

#Theme
# theme = Gruvbox Dark
theme = Everforest Dark Hard

confirm-close-surface = false
clipboard-paste-protection = false
unfocused-split-opacity = 1.0

copy-on-select = clipboard
scrollback-limit = 134217728

keybind = ctrl+shift+r=reload_config
keybind = ctrl+b=toggle_window_decorations
keybind = ctrl+f=toggle_fullscreen

# https://ghostty.org/docs/config/reference#quick-terminal-size
quick-terminal-position="top"
# quick-terminal-autohide="true"
quick-terminal-size=500px
