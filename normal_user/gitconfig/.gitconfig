[user]
        email = pvishwa1@volvocars.com
        name = Prakash Vishwakarma
	signingkey = /home/pvishwa1/.ssh/id_rsa.pub
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[includeIf "gitdir:~/Public/gitrepo/**"]
	path = ~/Public/gitrepo/dotfiles/.gitconfig
[core]
	autocrlf = input
[safe]
	directory = /opt/update-vcclc
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/pvishwa1/.ssh/allowed_signers
