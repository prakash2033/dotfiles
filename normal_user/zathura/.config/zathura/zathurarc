include colors
set font                    "monospace 10"
set selection-notification  "false"
set selection-clipboard     "primary" #possible values "clipboard", "false"
set scroll-page-aware       "true"
set statusbar-home-tilde    "true"
set adjust-open             "width"
set statusbar-h-padding     10
set statusbar-v-padding     10
set recolor                 "false"

set highlight-color "#FF0000"
set highlight-active-color "#0000FF"

